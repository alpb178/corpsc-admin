# ─── Database ───
# With docker compose up -d from the repo root (port 5433 so it doesn't clash
# with a Postgres you may already have on 5432):
DATABASE_URL="postgresql://hub:hub@localhost:5433/corpsc_hub?schema=public"
# With a system-installed Postgres, something like:
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/corpsc_hub?schema=public"
# Only for the Prisma CLI (migrate). If DATABASE_URL goes through a pooler in
# transaction mode (Supabase :6543), put the direct connection or the session
# pooler (:5432) here. Left empty, DATABASE_URL is used.
# DIRECT_URL=

# ─── API ───
PORT=3001
# development turns on Swagger at /docs and lets any http://localhost:* through
# CORS. Anything else —or leaving it out— keeps both closed, as in production.
NODE_ENV=development
# Extra origins allowed by CORS, comma-separated.
# hub.corpsc.com is always allowed; any localhost, only with NODE_ENV=development.
CORS_ORIGINS=
# Requests per minute each project may send to /ingest/*. Default 600.
# INGEST_RATE_LIMIT_PER_MINUTE=

# ─── Auth ───
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Credential encryption ───
# Master key used to encrypt the projects' ingest keys.
# EXACTLY 32 bytes in base64:  openssl rand -base64 32
# If it's lost, the stored credentials are unrecoverable and have to be
# entered again. If it's rotated, they have to be re-encrypted (keyVersion).
HUB_ENCRYPTION_KEY=

# ─── First admin seed (optional, first run only) ───
# SEED_ADMIN_EMAIL=alex@corpsc.com
# SEED_ADMIN_PASSWORD=

