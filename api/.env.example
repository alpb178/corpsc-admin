# ─── Base de datos ───
# Con docker compose up -d desde la raíz del repo (puerto 5433 para no chocar
# con un Postgres que ya tengas en el 5432):
DATABASE_URL="postgresql://hub:hub@localhost:5433/corpsc_hub?schema=public"
# Con un Postgres instalado en el sistema, algo así:
# DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/corpsc_hub?schema=public"
# Solo para el CLI de Prisma (migrate). Si DATABASE_URL pasa por un pooler en
# modo transacción (Supabase :6543), aquí va la conexión directa o el session
# pooler (:5432). Vacía, se usa DATABASE_URL.
# DIRECT_URL=

# ─── API ───
PORT=3001
# Orígenes extra permitidos por CORS, separados por comas.
# hub.corpsc.com y cualquier localhost ya están permitidos por defecto.
CORS_ORIGINS=

# ─── Auth ───
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Cifrado de credenciales ───
# Clave maestra con la que se cifran las claves de envío de los proyectos.
# EXACTAMENTE 32 bytes en base64:  openssl rand -base64 32
# Si se pierde, las credenciales guardadas son irrecuperables y hay que
# volver a introducirlas. Si se rota, hay que recifrarlas (keyVersion).
HUB_ENCRYPTION_KEY=

# ─── Semilla del primer admin (opcional, solo la primera vez) ───
# SEED_ADMIN_EMAIL=alex@corpsc.com
# SEED_ADMIN_PASSWORD=

