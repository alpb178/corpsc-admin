// Schema of the CORPSC analytics hub.
//
// Data arrives by PUSH: each project in the group computes its daily
// aggregates and sends them to `POST /api/ingest/metrics`. The hub never goes
// out to fetch anything, so there are no windows, no watermarks and no
// third-party quotas.
//
// Central decision: the fact table (`MetricDaily`) is NARROW — one row per
// (project, source, day, metric, dimension, dimension value) — and not wide,
// with one column per metric. The reason is the business metrics that will
// come later: orders and revenue in take and Iris, leads and listings in Tu
// Chamba, invoices by status in Invoices. In a wide table that's dozens of
// almost-always-null columns and an ALTER TABLE every time a project exposes
// a new metric.
//
// The rule that comes with that decision and that CANNOT be relaxed: only
// ADDITIVE measures are persisted. No ctr, engagement_rate or avg_position in
// the database — the mean of the means is not the mean, and summing them
// across days gives false numbers. We store clicks, impressions and
// position_sum, and ratios are computed at read time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Hub users ─────────────────────────────

// The panel is internal but shows client data, so the role isn't an isAdmin
// boolean like in tu-chamba: we need to tell apart those who only look.
enum Role {
  ADMIN // manages sources, credentials and users; launches backfills
  ANALYST // sees everything and can relaunch ingestion for their own project
  VIEWER // read-only
}

model HubUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         Role      @default(VIEWER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("hub_user")
}

// ───────────────────────────── Site catalog ───────────────────────────

enum ProjectKind {
  OWN // CORPSC's own product
  CLIENT // client site
}

// Mirror of corpsc-portfolio/src/content/projects.ts: the `slug` is the key
// shared between the portfolio and the hub.
model Project {
  id     String      @id @default(uuid())
  slug   String      @unique @db.VarChar(64)
  name   String
  /// Host without scheme or trailing slash: "tu-chamba.corpsc.com".
  domain String      @unique @db.VarChar(255)
  kind   ProjectKind

  /// Defines where a "day" starts and ends for this project. The submission
  /// declares its own and the hub warns if they don't match: a mismatch shifts
  /// the series by a day and nobody notices until someone compares two sites.
  timezone String  @default("America/La_Paz")
  /// Default currency for CURRENCY metrics (ISO 4217).
  currency String? @db.VarChar(3)

  /// Key this project identifies itself with when sending its metrics.
  /// Without it the project can't send anything.
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId String?     @map("credential_id")
  /// Last accepted submission. It's what lets us detect that a project has
  /// gone quiet for days, which is the inherent risk of receiving instead of
  /// fetching: if nobody looks, a broken cron goes unnoticed for weeks.
  lastPushAt   DateTime?   @map("last_push_at")
  active       Boolean     @default(true)
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  metrics  MetricDaily[]
  runs     IngestionRun[]
  events   SiteEvent[]
  visitors VisitorDaily[]
  goals    ConversionGoal[]

  @@index([active, sortOrder])
  @@map("project")
}

enum CredentialKind {
  API_KEY
}

// The key each project identifies itself with when sending. Encrypted with
// AES-256-GCM; the master key lives in HUB_ENCRYPTION_KEY, outside the database.
// No output DTO exposes `ciphertext`.
model Credential {
  id    String         @id @default(uuid())
  kind  CredentialKind
  label String

  /// base64(iv ‖ authTag ‖ ciphertext)
  ciphertext  String
  /// Lets the master key be rotated without decrypting everything at once.
  keyVersion  Int    @default(1) @map("key_version")
  /// sha256(plaintext)[0..16): used to verify that a rotation kept the value
  /// without having to decrypt it.
  fingerprint String @db.VarChar(16)

  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects Project[]

  @@map("credential")
}

// ─────────────────────── Metric catalog ───────────────────────
//
// Mandatory companion of the narrow model: without it, the dashboard receives
// a `metricKey` that is just text and doesn't know whether to format it as a
// number, as seconds or as money, or whether it can be summed.

enum MetricUnit {
  COUNT
  SECONDS
  RATIO
  CURRENCY
  POSITION
}

enum Aggregation {
  SUM
  WEIGHTED_AVG
  LAST
  MAX
}

model MetricDefinition {
  key         String      @id @db.VarChar(64)
  label       String
  labelEn     String?     @map("label_en")
  unit        MetricUnit
  aggregation Aggregation @default(SUM)

  /// If present, the metric is NOT persisted: it's computed at read time.
  /// { "numerator": "orders", "denominator": "visits" }
  derivedFrom Json? @map("derived_from")

  /// Metrics that show up in an internal endpoint and aren't cataloged come
  /// in with active=false: they're ingested anyway, but not shown until
  /// someone decides what they're called and how they're formatted.
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("metric_definition")
}

// ─────────────────────── Fact table ───────────────────────

model MetricDaily {
  id BigInt @id @default(autoincrement())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")

  /// Calendar day in the project's timezone, never UTC.
  date DateTime @db.Date

  metricKey String @map("metric_key") @db.VarChar(64)

  /// Open vocabulary (String, not enum, so we don't migrate every time a
  /// project sends a new dimension):
  /// total | channel | country | device | path | status | type | plan
  dimension String @db.VarChar(32)

  /// "__total__" when dimension = "total"; "__other__" for the rest of the
  /// top-N, so the breakdown adds up to the same as the total.
  dimValue String @map("dim_value") @db.VarChar(512)

  value    Decimal @db.Decimal(20, 4)
  /// Only for unit=CURRENCY. Without this someone would end up adding CUP to BOB.
  currency String? @db.VarChar(3)

  /// Traceability, not integrity: if the submission that wrote it is deleted,
  /// the row survives and only loses the pointer. What the orphan cleanup
  /// relies on is `ingestedAt`.
  run        IngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  runId      String?       @map("run_id")
  /// Stamp of the submission that wrote the row: lets us delete the ones this
  /// submission no longer returned within its own window.
  ingestedAt DateTime      @default(now()) @map("ingested_at")

  // Makes submissions idempotent: resending a day doesn't duplicate anything.
  @@unique([projectId, date, metricKey, dimension, dimValue], name: "metric_daily_natural_key")
  // A project's time series with breakdown: the dashboard's index.
  @@index([projectId, metricKey, dimension, date])
  // Replacing a submission's window.
  @@index([projectId, date])
  @@index([runId])
  @@map("metric_daily")
}

/// Single event from a site that has no backend to aggregate in.
///
/// The group's portfolio and the client sites are Vercel pages without a
/// database: they can't count their visits and send the aggregate the way Take
/// or Tu Chamba do. They send the raw fact, and the hub rolls it up on receipt.
///
/// It's the raw table: kept for 90 days and deleted on its own. Keeping it lets
/// us recompute a day —filter out a bot discovered late, fix a query— which a
/// counter incremented on the fly would not allow.
model SiteEvent {
  id BigInt @id @default(autoincrement())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")

  type SiteEventType

  /// Anonymous session issued by the site itself, so five pages aren't counted
  /// as five visits. It doesn't identify a person or outlive the visit.
  sessionId String @map("session_id") @db.VarChar(64)

  /// Path where it happened. No domain and no campaign parameters.
  path String @db.VarChar(512)

  /// Only on SITE_CLICK: slug of the group project the click goes to.
  target String? @db.VarChar(64)
  /// Only on SITE_CLICK: web · android · ios.
  linkType String? @map("link_type") @db.VarChar(16)

  /// On clicks: area of the page where it happened (header, nav, hero…).
  section String? @db.VarChar(64)
  /// On clicks: the button or link text, or its `data-track-label`.
  label   String? @db.VarChar(120)

  /// Two-letter ISO country. Set by the site's server from its hosting's
  /// header: the IP never leaves the site.
  country String? @db.VarChar(2)
  /// Only on the first page view of a load: the DOMAIN the visit came from,
  /// never the full URL, which may carry data about the visitor.
  referrer    String? @db.VarChar(255)
  utmSource   String? @map("utm_source") @db.VarChar(100)
  utmMedium   String? @map("utm_medium") @db.VarChar(100)
  utmCampaign String? @map("utm_campaign") @db.VarChar(100)

  /// Instant in UTC. Which DAY it belongs to is decided at rollup, in the
  /// project's timezone: storing it already truncated would make it impossible
  /// to fix if the project's timezone was set wrong.
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  // ── Contract v2. Every column is optional: v1 senders keep working while
  // the five sites migrate one by one. ──

  /// Issued by the browser, so a beacon sent twice —a retry, a remount— is
  /// stored once. NULL on v1 events: Postgres treats NULLs as distinct, so the
  /// unique index doesn't reject them.
  eventId   String? @map("event_id") @db.Uuid
  /// Random first-party identifier of the browser, issued by the site's
  /// server. It's what lets unique, new and returning visitors be told apart;
  /// it doesn't identify a person.
  visitorId String? @map("visitor_id") @db.VarChar(64)

  /// Only on CUSTOM: the event name (`contact_submit`, `add_to_cart`…) and
  /// its small, non-personal properties.
  name  String? @db.VarChar(64)
  props Json?

  /// Resolved by the site's hosting from the IP, like `country`. The IP never
  /// leaves the site.
  region String? @db.VarChar(8)
  city   String? @db.VarChar(100)

  /// Coarse families parsed from the user agent on the site's server. The
  /// user agent itself is never sent.
  device  String? @db.VarChar(16)
  browser String? @db.VarChar(32)
  os      String? @db.VarChar(32)

  /// Primary browser language (`es`, `pt`) and screen width bucket.
  language String? @db.VarChar(8)
  screen   String? @db.VarChar(16)

  // The rollup query: one project, a window of days.
  @@index([projectId, occurredAt])
  // Real time across the whole group: the last few minutes of every project.
  @@index([occurredAt])
  @@unique([projectId, eventId])
  @@map("site_event")
}

enum SiteEventType {
  PAGE_VIEW
  /// Click that leaves for another site in the group.
  SITE_CLICK
  /// Click on a link or button on the page itself.
  CLICK
  /// Named event the site defines: a form sent, a WhatsApp order…
  CUSTOM
}

/// One row per visitor and day in which they were seen.
///
/// Unique visitors can't be summed day by day —someone who comes on three days
/// would count three times— so they're counted at read time, as distinct
/// visitors over this table. It's far smaller than `site_event` (one row per
/// visitor-day, not per event) and outlives its 90 days, so a 12-month range
/// still has an answer. A visitor is new on the first date they appear here.
model VisitorDaily {
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  /// Calendar day in the project's timezone.
  date      DateTime @db.Date
  visitorId String   @map("visitor_id") @db.VarChar(64)

  @@id([projectId, date, visitorId])
  // "When was this visitor first seen?": new versus returning.
  @@index([projectId, visitorId, date])
  @@map("visitor_daily")
}

/// Custom events a project counts as conversions.
///
/// It's configuration, not data: the site sends `contact_submit` like any
/// other event, and whether that's a conversion is decided here, so changing
/// the goal doesn't require redeploying the site.
model ConversionGoal {
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  eventName String   @map("event_name") @db.VarChar(64)
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([projectId, eventName])
  @@map("conversion_goal")
}

// ─────────────────────── Run tracking ───────────────────────

enum RunStatus {
  SUCCESS
  PARTIAL
  REJECTED
}

enum RunTrigger {
  /// The project's scheduled submission.
  PUSH
  /// Resubmission launched by hand, usually to fix historical data.
  BACKFILL
  /// Rollup of the events of a site without its own backend. Nobody sends it:
  /// the hub runs it when it receives events and every night.
  ROLLUP
}

/// A received submission. It's the record that lets us answer "why is
/// Tuesday's data missing?" without guessing.
model IngestionRun {
  id        String  @id @default(uuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")

  trigger RunTrigger
  status  RunStatus

  /// Window declared by the submission. The hub replaces exactly that range:
  /// whatever the project doesn't send again within it is deleted.
  windowFrom DateTime @map("window_from") @db.Date
  windowTo   DateTime @map("window_to") @db.Date

  receivedAt DateTime @default(now()) @map("received_at")
  durationMs Int?     @map("duration_ms")

  rowsWritten Int @default(0) @map("rows_written")
  rowsDeleted Int @default(0) @map("rows_deleted")

  /// CONTRACT_VIOLATION · EMPTY_RESULT · WINDOW_TOO_LARGE…
  errorCode    String? @map("error_code") @db.VarChar(64)
  errorMessage String? @map("error_message")
  /// Warnings that don't invalidate the submission but the panel must show:
  /// timezone mismatch, undeclared metrics, truncated breakdowns.
  warnings     Json?

  metrics MetricDaily[]

  @@index([projectId, receivedAt(sort: Desc)])
  @@index([status, receivedAt(sort: Desc)])
  @@map("ingestion_run")
}
