// Esquema del hub de analítica de CORPSC.
//
// Los datos llegan por EMPUJE: cada proyecto del grupo calcula sus agregados
// diarios y los envía a `POST /api/ingest/metrics`. El hub no sale a buscar
// nada, así que no hay ventanas, ni watermarks, ni cuotas de terceros.
//
// Decisión central: la tabla de hechos (`MetricDaily`) es ESTRECHA — una fila
// por (proyecto, fuente, día, métrica, dimensión, valor de dimensión) — y no
// ancha, con una columna por métrica. El motivo son las métricas de negocio
// que llegarán después: pedidos e ingresos en take e Iris, leads y
// publicaciones en Tu Chamba, facturas por estado en Invoices. En una tabla
// ancha eso son decenas de columnas casi siempre nulas y un ALTER TABLE cada
// vez que un proyecto expone una métrica nueva.
//
// Regla que acompaña a esa decisión y que NO se puede relajar: solo se
// persisten medidas ADITIVAS. Nada de ctr, engagement_rate ni avg_position en
// la base — la media de las medias no es la media, y sumarlas entre días da
// números falsos. Se guardan clicks, impressions y position_sum, y los
// ratios se calculan al leer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Usuarios del hub ─────────────────────────────

// El panel es interno pero muestra datos de clientes, así que el rol no es un
// booleano isAdmin como en tu-chamba: hace falta distinguir a quien solo mira.
enum Role {
  ADMIN // gestiona fuentes, credenciales y usuarios; lanza backfills
  ANALYST // ve todo y puede lanzar reingestas de su propio proyecto
  VIEWER // solo lectura
}

model HubUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         Role      @default(VIEWER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("hub_user")
}

// ───────────────────────────── Catálogo de sitios ───────────────────────────

enum ProjectKind {
  OWN // producto propio de CORPSC
  CLIENT // sitio de cliente
}

// Espejo de corpsc-portfolio/src/content/projects.ts: el `slug` es la clave
// compartida entre el portfolio y el hub.
model Project {
  id     String      @id @default(uuid())
  slug   String      @unique @db.VarChar(64)
  name   String
  /// Host sin esquema ni barra final: "tu-chamba.corpsc.com".
  domain String      @unique @db.VarChar(255)
  kind   ProjectKind

  /// Define dónde empieza y acaba un "día" para este proyecto. El envío
  /// declara la suya y el hub avisa si no coinciden: un desajuste desplaza
  /// las series un día y no se nota hasta que alguien compara dos sitios.
  timezone String  @default("America/La_Paz")
  /// Moneda por defecto de las métricas CURRENCY (ISO 4217).
  currency String? @db.VarChar(3)

  /// Clave con la que este proyecto se identifica al enviar sus métricas.
  /// Sin ella el proyecto no puede enviar nada.
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId String?     @map("credential_id")
  /// Último envío aceptado. Es lo que permite detectar que un proyecto lleva
  /// días callado, que es el riesgo propio de recibir en vez de ir a buscar:
  /// si nadie mira, un cron roto pasa desapercibido durante semanas.
  lastPushAt   DateTime?   @map("last_push_at")
  active       Boolean     @default(true)
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  metrics MetricDaily[]
  runs    IngestionRun[]
  events  SiteEvent[]

  @@index([active, sortOrder])
  @@map("project")
}

enum CredentialKind {
  API_KEY
}

// La clave con la que cada proyecto se identifica al enviar. Se cifra con
// AES-256-GCM; la clave maestra vive en HUB_ENCRYPTION_KEY, fuera de la base.
// Ningún DTO de salida expone `ciphertext`.
model Credential {
  id    String         @id @default(uuid())
  kind  CredentialKind
  label String

  /// base64(iv ‖ authTag ‖ ciphertext)
  ciphertext  String
  /// Permite rotar la clave maestra sin descifrarlo todo de golpe.
  keyVersion  Int    @default(1) @map("key_version")
  /// sha256(plaintext)[0..16): sirve para verificar que una rotación ha
  /// conservado el valor sin tener que descifrarlo.
  fingerprint String @db.VarChar(16)

  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects Project[]

  @@map("credential")
}

// ─────────────────────── Catálogo de métricas ───────────────────────
//
// Compañero obligatorio del modelo estrecho: sin él, el dashboard recibe una
// `metricKey` que es solo texto y no sabe si formatearla como número, como
// segundos o como dinero, ni si puede sumarla.

enum MetricUnit {
  COUNT
  SECONDS
  RATIO
  CURRENCY
  POSITION
}

enum Aggregation {
  SUM
  WEIGHTED_AVG
  LAST
  MAX
}

model MetricDefinition {
  key         String      @id @db.VarChar(64)
  label       String
  labelEn     String?     @map("label_en")
  unit        MetricUnit
  aggregation Aggregation @default(SUM)

  /// Si está presente, la métrica NO se persiste: se calcula al leer.
  /// { "numerator": "orders", "denominator": "visits" }
  derivedFrom Json? @map("derived_from")

  /// Las métricas que aparezcan en un endpoint interno y no estén catalogadas
  /// entran con active=false: se ingieren igual, pero no se muestran hasta
  /// que alguien decida cómo se llaman y cómo se formatean.
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("metric_definition")
}

// ─────────────────────── Tabla de hechos ───────────────────────

model MetricDaily {
  id BigInt @id @default(autoincrement())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")

  /// Día calendario en la zona horaria del proyecto, nunca UTC.
  date DateTime @db.Date

  metricKey String @map("metric_key") @db.VarChar(64)

  /// Vocabulario abierto (String, no enum, para no migrar cada vez que un
  /// proyecto envía una dimensión nueva):
  /// total | channel | country | device | path | status | type | plan
  dimension String @db.VarChar(32)

  /// "__total__" cuando dimension = "total"; "__other__" para el resto del
  /// top-N, de modo que el desglose sume igual que el total.
  dimValue String @map("dim_value") @db.VarChar(512)

  value    Decimal @db.Decimal(20, 4)
  /// Solo para unit=CURRENCY. Sin esto alguien acabaría sumando CUP con BOB.
  currency String? @db.VarChar(3)

  /// Trazabilidad, no integridad: si se borra el envío que la escribió, la
  /// fila sobrevive y solo pierde el puntero. Lo que sostiene la limpieza de
  /// huérfanos es `ingestedAt`.
  run        IngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  runId      String?       @map("run_id")
  /// Marca del envío que escribió la fila: permite borrar las que este envío
  /// ya no ha devuelto dentro de su propia ventana.
  ingestedAt DateTime      @default(now()) @map("ingested_at")

  // Hace el envío idempotente: reenviar un día no duplica nada.
  @@unique([projectId, date, metricKey, dimension, dimValue], name: "metric_daily_natural_key")
  // Serie temporal de un proyecto con desglose: el índice del dashboard.
  @@index([projectId, metricKey, dimension, date])
  // Reemplazo de la ventana de un envío.
  @@index([projectId, date])
  @@index([runId])
  @@map("metric_daily")
}

/// Evento suelto de un sitio que no tiene backend donde agregar.
///
/// El portfolio del grupo y los sitios de cliente son páginas en Vercel sin
/// base de datos: no pueden contar sus visitas y mandar el agregado como hacen
/// Take o Tu Chamba. Mandan el hecho, y el hub lo consolida cada noche.
///
/// Es la tabla cruda: se conserva 90 días y se borra sola. Guardarla permite
/// recalcular un día —filtrar un bot que se descubre tarde, corregir una
/// consulta— cosa que un contador incrementado sobre la marcha no permitiría.
model SiteEvent {
  id BigInt @id @default(autoincrement())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")

  type SiteEventType

  /// Sesión anónima que emite el propio sitio, para no contar cinco páginas
  /// como cinco visitas. No identifica a una persona ni dura más que la visita.
  sessionId String @map("session_id") @db.VarChar(64)

  /// Ruta donde ocurrió. Sin dominio y sin parámetros de campaña.
  path String @db.VarChar(512)

  /// Solo en SITE_CLICK: slug del proyecto del grupo al que va el clic.
  target String? @db.VarChar(64)
  /// Solo en SITE_CLICK: web · android · ios.
  linkType String? @map("link_type") @db.VarChar(16)

  /// Instante en UTC. A qué DÍA pertenece se decide al consolidar, en la zona
  /// horaria del proyecto: guardarlo ya recortado impediría corregirlo si la
  /// zona del proyecto estaba mal puesta.
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  // La consulta de la consolidación: un proyecto, una ventana de días.
  @@index([projectId, occurredAt])
  @@map("site_event")
}

enum SiteEventType {
  PAGE_VIEW
  SITE_CLICK
}

// ─────────────────────── Control de ejecución ───────────────────────

enum RunStatus {
  SUCCESS
  PARTIAL
  REJECTED
}

enum RunTrigger {
  /// Envío programado del proyecto.
  PUSH
  /// Reenvío lanzado a mano, normalmente para corregir un histórico.
  BACKFILL
  /// Consolidación de los eventos de un sitio sin backend propio. No lo manda
  /// nadie: lo ejecuta el hub cada noche sobre lo que ha ido recibiendo.
  ROLLUP
}

/// Un envío recibido. Es el registro que permite responder "¿por qué falta
/// el dato del martes?" sin adivinar.
model IngestionRun {
  id        String  @id @default(uuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")

  trigger RunTrigger
  status  RunStatus

  /// Ventana que declara el envío. El hub reemplaza exactamente ese rango:
  /// lo que el proyecto no vuelva a mandar dentro de él, se borra.
  windowFrom DateTime @map("window_from") @db.Date
  windowTo   DateTime @map("window_to") @db.Date

  receivedAt DateTime @default(now()) @map("received_at")
  durationMs Int?     @map("duration_ms")

  rowsWritten Int @default(0) @map("rows_written")
  rowsDeleted Int @default(0) @map("rows_deleted")

  /// CONTRACT_VIOLATION · EMPTY_RESULT · WINDOW_TOO_LARGE…
  errorCode    String? @map("error_code") @db.VarChar(64)
  errorMessage String? @map("error_message")
  /// Avisos que no invalidan el envío pero el panel debe mostrar: desfase de
  /// zona horaria, métricas sin declarar, desgloses recortados.
  warnings     Json?

  metrics MetricDaily[]

  @@index([projectId, receivedAt(sort: Desc)])
  @@index([status, receivedAt(sort: Desc)])
  @@map("ingestion_run")
}
