{
  "compilerOptions": {
    // The same baseline as the five sites that receive these files: whatever
    // compiles here compiles there.
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "scripts", "test", "vitest.config.ts"]
}
